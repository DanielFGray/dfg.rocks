# Run the testimonial reminder sweep once per hour.
0 * * * * testimonials__reminder_sweep ?jobKey=testimonials__reminder_sweep

# Bill the current America/Chicago month once per day.
0 0 * * * bills__issue_monthly ?jobKey=bills__issue_monthly

# The calendar poll requeues itself, but a crash can lose the successor job.
# Re-add the singleton poll every five minutes, in the same serial queue and
# with the same single attempt as the successor the poll queues.
*/5 * * * * gcal__sync ?jobKey=gcal__sync&queue=gcal&max=1
