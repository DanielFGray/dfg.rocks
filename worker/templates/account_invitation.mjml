<mjml>
  <mj-head>
    <mj-attributes>
      <mj-class name="background" background-color="#f5f5f5" font-size="13px" />
      <mj-class
        name="bold-text"
        align="center"
        font-size="20px"
        font-family="Helvetica"
        font-weight="bold"
      />
      <mj-class name="text" align="center" font-size="16px" font-family="Helvetica" />
      <mj-class name="small-text" align="center" font-size="13px" font-family="Helvetica" />
      <mj-class name="accent-section" background-color="#1a1a2e" />
      <mj-class name="white-section" background-color="#fff" />
    </mj-attributes>
    <mj-style inline="inline">
      .note { white-space: pre-line; }
    </mj-style>
  </mj-head>

  <mj-body mj-class="background">
    <mj-section padding-bottom="20px"></mj-section>

    <mj-section mj-class="accent-section">
      <mj-column width="100%">
        <mj-text
          mj-class="bold-text"
          color="#FFF"
          padding-left="25px"
          padding-right="25px"
          padding-bottom="28px"
          padding-top="28px"
        >
          <% if (inviteeName) { %>Hi [[inviteeName]], you<% } else { %>You<% } %>'ve been invited to [[projectName]]!
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section mj-class="white-section">
      <mj-column width="100%">
        <% if (message) { %>
        <mj-text mj-class="text" css-class="note" padding-bottom="10px">[[message]]</mj-text>
        <% if (inviterName) { %>
        <mj-text mj-class="small-text" color="#777" padding-bottom="10px">&mdash; [[inviterName]]</mj-text>
        <% } %>
        <% } %>
        <mj-text mj-class="text" padding-bottom="10px">
          Your account is ready. Click below to log in and finish setting it up.
        </mj-text>
        <mj-button
          mj-class="text"
          background-color="#1a1a2e"
          color="#FFF"
          font-weight="bold"
          border="none"
          padding="15px 30px"
          border-radius="10px"
          href="[[loginLink]]"
          font-family="Helvetica"
          padding-left="25px"
          padding-right="25px"
          padding-bottom="20px"
        >
          Log in
        </mj-button>
        <mj-text mj-class="small-text" color="#777" padding-bottom="20px">
          This link works once and expires in 30 days. If you weren't expecting this
          invitation, you can safely ignore this email.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section mj-class="accent-section">
      <mj-column width="100%">
        <mj-text
          mj-class="text"
          color="#FFF"
          padding-left="25px"
          padding-right="25px"
          padding-bottom="20px"
          padding-top="20px"
        >
          Best,<br />
          The [[projectName]] Team
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section>
      <mj-column width="100%">
        <mj-text
          mj-class="small-text"
          color="#777"
          padding-left="25px"
          padding-right="25px"
          padding-bottom="20px"
          padding-top="20px"
        >
          [[legalText]]
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
