<mjml>
  <mj-head>
    <mj-attributes>
      <mj-class name="background" background-color="#f5f5f5" font-size="13px" />
      <mj-class
        name="bold-text"
        align="center"
        font-size="20px"
        font-family="Helvetica"
        font-weight="bold"
      />
      <mj-class name="text" align="center" font-size="16px" font-family="Helvetica" />
      <mj-class name="small-text" align="center" font-size="13px" font-family="Helvetica" />
      <mj-class name="accent-section" background-color="#1a1a2e" />
      <mj-class name="white-section" background-color="#fff" />
    </mj-attributes>
  </mj-head>

  <mj-body mj-class="background">
    <mj-section padding-bottom="20px"></mj-section>

    <mj-section mj-class="accent-section">
      <mj-column width="100%">
        <mj-text
          mj-class="bold-text"
          color="#FFF"
          padding-left="25px"
          padding-right="25px"
          padding-bottom="28px"
          padding-top="28px"
        >
          New Contact Submission
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section mj-class="white-section">
      <mj-column width="100%">
        <mj-text mj-class="text" padding-bottom="10px">
          <strong>[[name]]</strong> ([[email]]) submitted the contact form.
        </mj-text>
        <mj-text mj-class="small-text" color="#777" padding-bottom="10px">
          Phone: [[phone]] | Instrument: [[instrument]] | Format: [[format]]
        </mj-text>
        <mj-text mj-class="text" padding-bottom="20px"> [[message]] </mj-text>
      </mj-column>
    </mj-section>


    <mj-section>
      <mj-column width="100%">
        <mj-text
          mj-class="small-text"
          color="#777"
          padding-left="25px"
          padding-right="25px"
          padding-bottom="20px"
          padding-top="20px"
        >
          [[legalText]]
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
