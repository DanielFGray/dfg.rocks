<mjml>
  <mj-head>
    <mj-attributes>
      <mj-class name="background" background-color="#f5f5f5" font-size="13px" />
      <mj-class name="bold-text" align="center" font-size="20px" font-family="Helvetica" font-weight="bold" />
      <mj-class name="text" align="center" font-size="16px" font-family="Helvetica" />
      <mj-class name="small-text" align="center" font-size="13px" font-family="Helvetica" />
      <mj-class name="accent-section" background-color="#1a1a2e" />
      <mj-class name="white-section" background-color="#fff" />
    </mj-attributes>
  </mj-head>

  <mj-body mj-class="background">
    <mj-section padding-bottom="20px"></mj-section>

    <mj-section mj-class="accent-section">
      <mj-column width="100%">
        <mj-text mj-class="bold-text" color="#FFF" padding-left="25px" padding-right="25px" padding-bottom="28px" padding-top="28px">
          Account Deletion Request
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section mj-class="white-section">
      <mj-column width="100%">
        <mj-text mj-class="text" padding-bottom="10px">
          You requested to delete your [[projectName]] account. This action is permanent and cannot be undone.
        </mj-text>
        <mj-text mj-class="text" padding-bottom="10px">
          If you did not request this, you can safely ignore this email.
        </mj-text>
        <mj-button
          mj-class="text"
          background-color="#dc2626"
          color="#FFF"
          font-weight="bold"
          border="none"
          padding="15px 30px"
          border-radius="10px"
          href="[[deleteLink]]"
          font-family="Helvetica"
          padding-left="25px"
          padding-right="25px"
          padding-bottom="20px"
        >
          Confirm Deletion
        </mj-button>
        <mj-text mj-class="small-text" color="#777" padding-bottom="20px">
          This link expires in 1 hour.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section mj-class="accent-section">
      <mj-column width="100%">
        <mj-text mj-class="text" color="#FFF" padding-left="25px" padding-right="25px" padding-bottom="20px" padding-top="20px">
          Best,<br />
          The [[projectName]] Team
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section>
      <mj-column width="100%">
        <mj-text mj-class="small-text" color="#777" padding-left="25px" padding-right="25px" padding-bottom="20px" padding-top="20px">
          [[legalText]]
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
