{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "plugins": [
      { "name": "@effect/language-service" }
    ]
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "shared/**/*.ts"],
  "exclude": ["app/routeTree.gen.ts"]
}
