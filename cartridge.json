{
  "apiVersion": "server-ansible/v2",
  "name": "dfg-rocks",
  "postgres": [
    {
      "database": "dfg_rocks",
      "extensions": ["citext", "pgcrypto", "uuid-ossp"]
    }
  ],
  "services": [
    {
      "name": "dfg-rocks-server",
      "image": "registry.cluster:5000/dfg-rocks",
      "hostPort": "dynamic",
      "containerPort": 3000,
      "healthCheck": { "type": "http", "path": "/api/health" },
      "cpu": 300,
      "memoryMB": 512,
      "networkMode": "bridge",
      "storage": { "volume": "dfg-rocks-uploads", "mountPath": "/app/uploads" },
      "command": "bun",
      "args": ["run", "start"],
      "migrate": {
        "command": "bun",
        "args": ["run", "migrate"],
        "secrets": [
          {
            "_tag": "PostgresCredentials",
            "database": "dfg_rocks",
            "login": "migration",
            "urlEnv": "DATABASE_URL"
          },
          {
            "_tag": "PostgresCredentials",
            "database": "dfg_rocks",
            "login": "api",
            "urlEnv": "AUTH_DATABASE_URL"
          },
          { "_tag": "KvSecret", "path": "secret/data/dfg-rocks", "key": "admin_email", "env": "ADMIN_EMAIL" }
        ]
      },
      "routes": [{ "host": "dfg.rocks" }],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "3000" },
        { "name": "VITE_ROOT_URL", "value": "https://dfg.rocks" },
        { "name": "UPLOADS_DIR", "value": "/app/uploads" },
        { "name": "DATABASE_VISITOR", "database": "dfg_rocks", "role": "visitor" }
      ],
      "connections": [],
      "secrets": [
        {
          "_tag": "PostgresCredentials",
          "database": "dfg_rocks",
          "login": "migration",
          "urlEnv": "DATABASE_URL"
        },
        {
          "_tag": "PostgresCredentials",
          "database": "dfg_rocks",
          "login": "api",
          "urlEnv": "AUTH_DATABASE_URL"
        },
        { "_tag": "KvSecret", "path": "secret/data/dfg-rocks", "key": "admin_email", "env": "ADMIN_EMAIL" },
        { "_tag": "KvSecret", "path": "secret/data/dfg-rocks", "key": "resend_api_key", "env": "RESEND_API_KEY" },
        { "_tag": "KvSecret", "path": "secret/data/dfg-rocks", "key": "google_client_id", "env": "GOOGLE_CLIENT_ID" },
        { "_tag": "KvSecret", "path": "secret/data/dfg-rocks", "key": "google_client_secret", "env": "GOOGLE_CLIENT_SECRET" },
        { "_tag": "KvSecret", "path": "secret/data/dfg-rocks", "key": "google_calendar_client_id", "env": "GOOGLE_CALENDAR_CLIENT_ID" },
        { "_tag": "KvSecret", "path": "secret/data/dfg-rocks", "key": "google_calendar_client_secret", "env": "GOOGLE_CALENDAR_CLIENT_SECRET" },
        { "_tag": "KvSecret", "path": "secret/data/dfg-rocks", "key": "apple_client_id", "env": "APPLE_CLIENT_ID" },
        { "_tag": "KvSecret", "path": "secret/data/dfg-rocks", "key": "apple_team_id", "env": "APPLE_TEAM_ID" },
        { "_tag": "KvSecret", "path": "secret/data/dfg-rocks", "key": "apple_key_id", "env": "APPLE_KEY_ID" },
        { "_tag": "KvSecret", "path": "secret/data/dfg-rocks", "key": "apple_private_key", "env": "APPLE_PRIVATE_KEY" }
      ]
    },
    {
      "name": "dfg-rocks-worker",
      "image": "registry.cluster:5000/dfg-rocks",
      "hostPort": "dynamic",
      "containerPort": 3000,
      "cpu": 200,
      "memoryMB": 256,
      "networkMode": "bridge",
      "command": "bun",
      "args": ["run", "worker:prod"],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "VITE_ROOT_URL", "value": "https://dfg.rocks" },
        { "name": "DATABASE_VISITOR", "database": "dfg_rocks", "role": "visitor" }
      ],
      "connections": [],
      "secrets": [
        {
          "_tag": "PostgresCredentials",
          "database": "dfg_rocks",
          "login": "migration",
          "urlEnv": "DATABASE_URL"
        },
        {
          "_tag": "PostgresCredentials",
          "database": "dfg_rocks",
          "login": "api",
          "urlEnv": "AUTH_DATABASE_URL"
        },
        { "_tag": "KvSecret", "path": "secret/data/dfg-rocks", "key": "admin_email", "env": "ADMIN_EMAIL" },
        { "_tag": "KvSecret", "path": "secret/data/dfg-rocks", "key": "aws_access_key_id", "env": "AWS_ACCESS_KEY_ID" },
        { "_tag": "KvSecret", "path": "secret/data/dfg-rocks", "key": "aws_secret_access_key", "env": "AWS_SECRET_ACCESS_KEY" },
        { "_tag": "KvSecret", "path": "secret/data/dfg-rocks", "key": "google_calendar_client_id", "env": "GOOGLE_CALENDAR_CLIENT_ID" },
        { "_tag": "KvSecret", "path": "secret/data/dfg-rocks", "key": "google_calendar_client_secret", "env": "GOOGLE_CALENDAR_CLIENT_SECRET" }
      ]
    }
  ]
}
