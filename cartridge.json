{
  "apiVersion": "roamancer/v2",
  "name": "dfg-rocks",
  "postgres": [
    {
      "database": "dfg_rocks",
      "extensions": ["citext", "pgcrypto", "uuid-ossp"]
    }
  ],
  "objectStore": {},
  "valkey": {},
  "services": [
    {
      "name": "dfg-rocks-server",
      "image": "registry.cluster:5000/dfg-rocks",
      "hostPort": "dynamic",
      "containerPort": 3000,
      "healthCheck": { "type": "http", "path": "/healthz" },
      "cpu": 300,
      "memoryMB": 768,
      "networkMode": "bridge",
      "command": "bun",
      "args": ["run", "start"],
      "migrate": {
        "command": "bun",
        "args": ["run", "migrate"],
        "staged": { "args": ["run", "migrate:staged"] },
        "secrets": [
          {
            "_tag": "PostgresCredentials",
            "database": "dfg_rocks",
            "login": "migration",
            "urlEnv": "DATABASE_URL"
          },
          {
            "_tag": "PostgresCredentials",
            "database": "dfg_rocks",
            "login": "api",
            "urlEnv": "AUTH_DATABASE_URL"
          },
          { "_tag": "KvSecret", "path": "secret/data/dfg-rocks", "key": "admin_email", "env": "ADMIN_EMAIL" }
        ]
      },
      "routes": [{ "host": "dfg.rocks" }],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "3000" },
        { "name": "VITE_ROOT_URL", "value": "https://dfg.rocks" },
        { "name": "MAIL_PROVIDER", "value": "cloudflare" },
        { "name": "EMAIL_FROM", "value": "DFG Music Lessons <noreply@dfg.rocks>" },
        { "name": "DATABASE_VISITOR", "database": "dfg_rocks", "role": "visitor" },
        { "name": "DATABASE_OWNER", "database": "dfg_rocks", "role": "owner" },
        { "name": "VALKEY_KEY_PREFIX", "valkey": "keyPrefix" },
        { "name": "OTEL_EXPORTER_OTLP_ENDPOINT", "value": "http://host.containers.internal:4318" },
        { "name": "OTEL_LOGS_EXPORTER", "value": "otlp" }
      ],
      "connections": [],
      "secrets": [
        {
          "_tag": "PostgresCredentials",
          "database": "dfg_rocks",
          "login": "migration",
          "urlEnv": "DATABASE_URL"
        },
        {
          "_tag": "PostgresCredentials",
          "database": "dfg_rocks",
          "login": "api",
          "urlEnv": "AUTH_DATABASE_URL"
        },
        {
          "_tag": "ObjectStoreCredentials",
          "endpointEnv": "S3_ENDPOINT",
          "regionEnv": "S3_REGION",
          "bucketEnv": "S3_BUCKET",
          "accessKeyIdEnv": "S3_ACCESS_KEY_ID",
          "secretAccessKeyEnv": "S3_SECRET_ACCESS_KEY"
        },
        { "_tag": "ValkeyCredentials", "urlEnv": "VALKEY_URL" },
        { "_tag": "KvSecret", "path": "secret/data/dfg-rocks", "key": "admin_email", "env": "ADMIN_EMAIL" },
        { "_tag": "KvSecret", "path": "secret/data/dfg-rocks", "key": "google_client_id", "env": "GOOGLE_CLIENT_ID" },
        { "_tag": "KvSecret", "path": "secret/data/dfg-rocks", "key": "google_client_secret", "env": "GOOGLE_CLIENT_SECRET" },
        { "_tag": "KvSecret", "path": "secret/data/dfg-rocks", "key": "google_calendar_client_id", "env": "GOOGLE_CALENDAR_CLIENT_ID" },
        { "_tag": "KvSecret", "path": "secret/data/dfg-rocks", "key": "google_calendar_client_secret", "env": "GOOGLE_CALENDAR_CLIENT_SECRET" },
        { "_tag": "KvSecret", "path": "secret/data/dfg-rocks", "key": "cloudflare_email_api_token", "env": "CLOUDFLARE_EMAIL_API_TOKEN" },
        { "_tag": "KvSecret", "path": "secret/data/dfg-rocks", "key": "stripe_secret_key", "env": "STRIPE_SECRET_KEY" },
        { "_tag": "KvSecret", "path": "secret/data/dfg-rocks", "key": "stripe_webhook_secret", "env": "STRIPE_WEBHOOK_SECRET" }
      ]
    }
  ]
}
