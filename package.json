{
  "name": "dfg-rocks",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "predev": "bun scripts/dbEnsure.ts",
    "dev": "mprocs 'bun worker' 'bun dev:app' 'bun typecheck:watch' 'docker compose up db' 'bun test:unit' 'bun test:e2e'",
    "dev:app": "bun -b vite dev",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "build": "NODE_ENV=production bun -b vite build",
    "start": "NODE_ENV=production bun dist/server/server.js",
    "preview": "bun -b vite preview",
    "gm": "bun -b graphile-migrate",
    "db:up": "docker compose -f docker-compose.yml up -d",
    "db:ensure": "bun scripts/dbEnsure.ts",
    "db:init": "bun scripts/dbSetup.ts",
    "db:latest": "run-s 'gm watch --once'",
    "db:watch": "run-s 'gm watch'",
    "db:reset": "run-s 'gm reset --erase'",
    "db:types": "bun -b kysely-codegen",
    "db:setup": "run-s db:init db:reset db:latest",
    "env:init": "bun scripts/generateEnvFile.ts",
    "init": "NOCONFIRM=1 run-s env:init db:setup",
    "worker": "bun --cwd=worker --env-file=../.env graphile-worker",
    "lint": "oxlint .",
    "test": "run-s typecheck lint test:unit test:worker test:e2e",
    "test:unit": "vitest run",
    "test:worker": "bun test worker/test/bills.test.js worker/test/send_email.test.js worker/test/contracts.test.js",
    "test:e2e": "playwright test",
    "e2e:server": "bun scripts/e2eServer.ts",
    "migrate": "bun --cwd=worker graphile-worker --schema-only && graphile-migrate migrate",
    "worker:prod": "bun --cwd=worker graphile-worker"
  },
  "dependencies": {
    "@coderline/alphatab": "^1.9.0-alpha.1861",
    "@effect/experimental": "^0.60.0",
    "@effect/platform": "^0.96.3",
    "@effect/platform-browser": "^0.76.0",
    "@effect/platform-node": "^0.107.0",
    "@effect/sql-kysely": "^0.47.0",
    "@effect/sql-pg": "^0.52.1",
    "@internationalized/date": "^3.12.2",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "^1.168.28",
    "@tiptap/extension-link": "^3.28.0",
    "@tiptap/pm": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "@tw-classed/react": "^2.0.0",
    "arctic": "^3.7.0",
    "effect": "^3.22.0",
    "graphile-migrate": "2.0.0-rc.2",
    "graphile-worker": "^0.16.6",
    "html-to-text": "^9.0.5",
    "jose": "^6.2.3",
    "lodash": "^4.18.1",
    "mjml": "^5.4.0",
    "nodemailer": "^8.0.11",
    "pg": "^8.22.0",
    "pdfkit": "^0.16.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-aria": "^3.50.0",
    "react-aria-components": "^1.19.0",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "devDependencies": {
    "@effect/language-service": "^0.86.6",
    "@effect/vitest": "^0.30.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.9.5",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "kysely-codegen": "^0.20.0",
    "mprocs": "^0.9.6",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.74.0",
    "vite": "^8.1.5"
  },
  "fromEmail": "noreply@dfg.rocks",
  "patchedDependencies": {
    "@coderline/alphatab@1.9.0-alpha.1785": "patches/@coderline%2Falphatab@1.9.0-alpha.1785.patch",
    "@tanstack/router-generator@1.166.36": "patches/@tanstack%2Frouter-generator@1.166.36.patch",
    "@effect/sql-kysely@0.47.0": "patches/@effect%2Fsql-kysely@0.47.0.patch"
  },
  "projectName": "DFG Music Lessons"
}
