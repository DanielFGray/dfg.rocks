{
  "name": "dfg-rocks",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "predev": "bun scripts/dbEnsure.ts",
    "dev": "mprocs 'bun worker' 'bun dev:app' 'bun typecheck:watch'",
    "dev:app": "vite dev",
    "typecheck": "tsgo --noEmit",
    "typecheck:watch": "tsgo --noEmit --watch",
    "build": "vite build",
    "preview": "vite preview",
    "gm": "bun -b graphile-migrate",
    "db:up": "docker compose -f docker-compose.yml up -d",
    "db:ensure": "bun scripts/dbEnsure.ts",
    "db:init": "bun scripts/dbSetup.ts",
    "db:latest": "run-s 'gm watch --once'",
    "db:watch": "run-s 'gm watch'",
    "db:reset": "run-s 'gm reset --erase'",
    "db:types": "bun -b kysely-codegen",
    "db:setup": "run-s db:up db:init db:reset worker:schema db:latest",
    "env:init": "bun scripts/generateEnvFile.ts",
    "init": "NOCONFIRM=1 run-s env:init db:setup",
    "worker": "bun --cwd=worker --env-file=../.env graphile-worker",
    "worker:schema": "run-s 'worker --schema-only'",
    "test": "run-p test:unit test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "e2e:server": "bun scripts/e2eServer.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1039.0",
    "@coderline/alphatab": "^1.9.0-alpha.1785",
    "@elysiajs/eden": "^1.4.9",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-form": "^1.29.1",
    "@tanstack/react-query": "^5.100.6",
    "@tanstack/react-router": "^1.168.25",
    "@tanstack/react-start": "^1.167.51",
    "@tanstack/valibot-form-adapter": "^0.42.1",
    "@tiptap/extension-link": "^3.22.5",
    "@tiptap/pm": "^3.22.5",
    "@tiptap/react": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "arctic": "^3.7.0",
    "elysia": "^1.4.28",
    "graphile-migrate": "2.0.0-rc.2",
    "graphile-worker": "^0.16.6",
    "html-to-text": "^9.0.5",
    "ioredis": "^5.10.1",
    "jose": "^6.2.3",
    "kysely": "^0.28.16",
    "lodash": "^4.18.1",
    "mjml": "^5.1.0",
    "nodemailer": "^8.0.7",
    "pg": "^8.20.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.5",
    "react-aria": "^3.48.0",
    "react-aria-components": "^1.17.0",
    "react-dom": "^19.2.5",
    "resend": "^6.12.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "valibot": "^1.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/bun": "^1.3.14",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.8.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260421.2",
    "@vitejs/plugin-react": "^6.0.1",
    "kysely-codegen": "^0.20.0",
    "mprocs": "^0.9.2",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.65.0",
    "testcontainers": "^11.14.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "fromEmail": "noreply@dfg.rocks",
  "patchedDependencies": {
    "@coderline/alphatab@1.9.0-alpha.1785": "patches/@coderline%2Falphatab@1.9.0-alpha.1785.patch"
  },
  "projectName": "DFG Music Lessons"
}
