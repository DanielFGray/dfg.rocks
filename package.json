{
  "name": "dfg-rocks",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "predev": "bun run db:up",
    "dev": "mprocs 'bun dev:app' 'bun typecheck:watch' 'bun test:unit' 'bun test:e2e'",
    "dev:app": "bun --env-file=.env server/dev.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "build": "NODE_ENV=production bun --env-file=.env -b vite build",
    "start": "NODE_ENV=production bun server/main.ts",
    "preview": "bun -b vite preview",
    "gm": "bun --env-file=.env -b graphile-migrate",
    "stripe:sync": "bun --env-file=.env -b scripts/stripe-sync-prices.ts",
    "db:up": "ops dev db up",
    "db:latest": "bun --cwd=worker --env-file=../.env graphile-worker --schema-only && bun run gm watch --once",
    "db:watch": "run-s 'gm watch'",
    "db:reset": "ops dev db reset dfg_rocks_dev && bun run db:latest",
    "db:types": "bun --env-file=.env -b kysely-codegen",
    "db:setup": "run-s db:up db:reset",
    "env:init": "bun scripts/generateEnvFile.ts",
    "init": "NOCONFIRM=1 run-s env:init db:setup",
    "lint": "ast-grep scan server worker shared app/lib --globs 'server/**' --globs 'worker/**' --globs 'shared/**' --globs 'app/lib/*.server.ts' --globs 'app/lib/serverEffect.ts' && ast-grep test && oxlint .",
    "test": "run-s typecheck lint test:unit test:worker test:bun test:e2e",
    "test:unit": "ops dev db test -- vitest run",
    "test:worker": "ops dev db test -- sh -c 'bun scripts/migrateTestDatabase.ts && bun test worker/test'",
    "test:bun": "ops dev db test -- sh -c 'bun scripts/migrateTestDatabase.ts && bun test server/test/s3Objects.bun.test.ts server/test/oauthLink.bun.test.ts'",
    "test:e2e": "ops dev db test -- playwright test",
    "e2e:server": "bun scripts/e2eServer.ts",
    "migrate": "bun --cwd=worker graphile-worker --schema-only && graphile-migrate migrate",
    "migrate:staged": "bun run migrate && graphile-migrate watch --once",
    "db:stop": "ops dev db down",
    "prepare": "effect-tsgo patch --typescript && (git rev-parse --git-dir >/dev/null 2>&1 || exit 0; lefthook install --reset-hooks-path)"
  },
  "dependencies": {
    "@coderline/alphatab": "1.9.0",
    "@danielfgray/stompbox": "github:DanielFGray/effect-stompbox#v0.2.0",
    "@effect/platform-bun": "4.1.4",
    "@effect/platform-node": "4.1.4",
    "@effect/sql-pg": "4.1.4",
    "@internationalized/date": "^3.12.4",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "^1.169.5",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@tw-classed/react": "^2.0.0",
    "arctic": "^3.7.0",
    "effect": "4.1.4",
    "gigbag.js": "github:DanielFGray/gigbag#v0.4.3",
    "graphile-migrate": "2.0.0-rc.6",
    "graphile-worker": "^0.18.0",
    "html-to-text": "^10.0.1",
    "jose": "^6.2.17",
    "kysely": "0.29.9",
    "lodash.template": "^4.18.1",
    "mjml": "^5.4.1",
    "nodemailer": "^10.6.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.5",
    "@effect/tsgo": "0.69.0",
    "@effect/vitest": "4.1.4",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/html-to-text": "^9.0.4",
    "@types/lodash.template": "^4.5.3",
    "@types/mjml": "^5.4.2",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "kysely-codegen": "^0.20.0",
    "lefthook": "^2.2.2",
    "mprocs": "^0.9.6",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "vite": "^8.3.8"
  },
  "fromEmail": "noreply@dfg.rocks",
  "legalText": "",
  "patchedDependencies": {
    "@coderline/alphatab@1.9.0": "patches/@coderline%2Falphatab@1.9.0.patch"
  },
  "projectName": "DFG Music Lessons",
  "templateCopies": [
    "rules",
    "rule-tests"
  ]
}
