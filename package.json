{
  "name": "dfg-rocks",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "predev": "bun run db:up",
    "dev": "mprocs 'bun worker' 'bun dev:app' 'bun typecheck:watch' 'bun test:unit' 'bun test:e2e'",
    "dev:app": "bun --env-file=.env -b vite dev",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "build": "NODE_ENV=production bun --env-file=.env -b vite build",
    "start": "NODE_ENV=production bun serve.ts",
    "preview": "bun -b vite preview",
    "gm": "bun --env-file=.env -b graphile-migrate",
    "db:up": "ops dev db up",
    "db:latest": "bun --cwd=worker --env-file=../.env graphile-worker --schema-only && bun run gm watch --once",
    "db:watch": "run-s 'gm watch'",
    "db:reset": "ops dev db reset dfg_rocks && bun run db:latest",
    "db:types": "bun --env-file=.env -b kysely-codegen",
    "db:setup": "run-s db:up db:reset",
    "env:init": "bun scripts/generateEnvFile.ts",
    "init": "NOCONFIRM=1 run-s env:init db:setup",
    "worker": "bun --env-file=.env worker/main.ts",
    "lint": "oxlint .",
    "test": "run-s typecheck lint test:unit test:worker test:bun test:e2e",
    "test:unit": "vitest run",
    "test:worker": "bun test worker/test/bills.test.js worker/test/contracts.test.js",
    "test:bun": "bun test server/test/s3Objects.bun.test.ts",
    "test:e2e": "playwright test",
    "e2e:server": "bun scripts/e2eServer.ts",
    "migrate": "bun --cwd=worker graphile-worker --schema-only && graphile-migrate migrate",
    "db:stop": "ops dev db down",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 || exit 0; lefthook install --reset-hooks-path"
  },
  "dependencies": {
    "@coderline/alphatab": "^1.9.0",
    "@effect/platform-bun": "4.1.3",
    "@effect/platform-node": "4.1.3",
    "@effect/sql-pg": "4.1.3",
    "@internationalized/date": "^3.12.4",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "^1.169.5",
    "@tiptap/extension-link": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "@tw-classed/react": "^2.0.0",
    "arctic": "^3.7.0",
    "effect": "4.1.3",
    "graphile-migrate": "2.0.0-rc.6",
    "graphile-worker": "^0.16.6",
    "html-to-text": "^10.0.1",
    "jose": "^6.2.17",
    "kysely": "0.29.8",
    "lodash": "^4.18.1",
    "mjml": "^5.4.1",
    "nodemailer": "^10.5.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.5",
    "@effect/vitest": "4.1.3",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/html-to-text": "^9.0.4",
    "@types/lodash": "^4.17.27",
    "@types/mjml": "^5.4.2",
    "@types/node": "^25.9.9",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "kysely-codegen": "^0.20.0",
    "lefthook": "^2.2.2",
    "mprocs": "^0.9.6",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.93.0",
    "vite": "^8.3.7"
  },
  "fromEmail": "noreply@dfg.rocks",
  "legalText": "",
  "patchedDependencies": {
    "@coderline/alphatab@1.9.0-alpha.1785": "patches/@coderline%2Falphatab@1.9.0-alpha.1785.patch"
  },
  "projectName": "DFG Music Lessons"
}
