{
  "name": "dfg-rocks",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "predev": "bun scripts/dbEnsure.ts",
    "dev": "mprocs 'bun worker' 'bun dev:app' 'bun typecheck:watch'",
    "dev:app": "bun -b vite dev",
    "typecheck": "tsgo --noEmit",
    "typecheck:watch": "tsgo --noEmit --watch",
    "prebuild": "run-s test",
    "build": "bun -b vite build",
    "preview": "bun -b vite preview",
    "gm": "bun -b graphile-migrate",
    "db:up": "docker compose -f docker-compose.yml up -d",
    "db:ensure": "bun scripts/dbEnsure.ts",
    "db:init": "bun scripts/dbSetup.ts",
    "db:latest": "run-s 'gm watch --once'",
    "db:watch": "run-s 'gm watch'",
    "db:reset": "run-s 'gm reset --erase'",
    "db:types": "bun -b kysely-codegen",
    "db:setup": "run-s db:up db:init db:reset worker:schema db:latest",
    "env:init": "bun scripts/generateEnvFile.ts",
    "init": "NOCONFIRM=1 run-s env:init db:setup",
    "worker": "bun --cwd=worker --env-file=../.env graphile-worker",
    "worker:schema": "run-s 'worker --schema-only'",
    "lint": "oxlint .",
    "test": "run-s typecheck lint test:unit test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "e2e:server": "bun scripts/e2eServer.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1056.0",
    "@coderline/alphatab": "^1.9.0-alpha.1813",
    "@effect/experimental": "^0.60.0",
    "@effect/platform": "^0.96.1",
    "@effect/platform-browser": "^0.76.0",
    "@effect/platform-node": "^0.106.0",
    "@effect/sql-kysely": "^0.47.0",
    "@effect/sql-pg": "^0.52.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-router": "^1.170.9",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "^1.168.16",
    "@tiptap/extension-link": "^3.23.6",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "@tw-classed/react": "^2.0.0",
    "arctic": "^3.7.0",
    "effect": "^3.21.2",
    "graphile-migrate": "2.0.0-rc.2",
    "graphile-worker": "^0.16.6",
    "html-to-text": "^9.0.5",
    "ioredis": "^5.11.0",
    "jose": "^6.2.3",
    "lodash": "^4.18.1",
    "mjml": "^5.3.0",
    "nodemailer": "^8.0.10",
    "pg": "^8.21.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-aria": "^3.49.0",
    "react-aria-components": "^1.18.0",
    "react-dom": "^19.2.6",
    "resend": "^6.12.4",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@effect/language-service": "^0.86.2",
    "@tailwindcss/vite": "^4.3.0",
    "@types/bun": "^1.3.14",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260527.2",
    "@vitejs/plugin-react": "^6.0.2",
    "kysely-codegen": "^0.20.0",
    "mprocs": "^0.9.3",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.67.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "fromEmail": "noreply@dfg.rocks",
  "patchedDependencies": {
    "@coderline/alphatab@1.9.0-alpha.1785": "patches/@coderline%2Falphatab@1.9.0-alpha.1785.patch",
    "@tanstack/router-generator@1.166.36": "patches/@tanstack%2Frouter-generator@1.166.36.patch"
  },
  "projectName": "DFG Music Lessons"
}
