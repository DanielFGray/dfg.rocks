{
  "name": "dfg-rocks",
  "type": "module",
  "version": "0.2.0",
  "fromEmail": "noreply@dfg.rocks",
  "projectName": "DFG Music Lessons",
  "scripts": {
    "predev": "bun scripts/dbEnsure.ts",
    "dev": "bunx mprocs",
    "dev:app": "bunx fibrae dev",
    "dev:server": "bun --watch server/index.ts",
    "dev:tui": "bunx effect-devtui",
    "typecheck": "tsgo --noEmit -p tsconfig.app.json",
    "typecheck:watch": "tsgo --noEmit --watch -p tsconfig.app.json",
    "prepare": "effect-language-service patch",
    "build": "bunx fibrae build",
    "preview": "bunx fibrae preview",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:ensure": "bun scripts/dbEnsure.ts",
    "db:init": "bun scripts/dbSetup.ts",
    "db:latest": "bun -b graphile-migrate watch --once",
    "db:watch": "bun -b graphile-migrate watch",
    "db:reset": "bun -b graphile-migrate reset --erase",
    "db:types": "bun -b kysely-codegen",
    "db:setup": "run-s db:up db:init db:reset db:latest 'worker --schema-only'",
    "env:init": "bun scripts/generateEnvFile.ts",
    "init": "NOCONFIRM=1 run-s env:init db:setup",
    "worker": "cd worker && bun --env-file=../.env graphile-worker",
    "worker:schema": "cd worker && bun --env-file=../.env graphile-worker --schema-only",
    "test": "run-p test:unit test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "bunx playwright test"
  },
  "dependencies": {
    "@astrojs/check": "0.9.6",
    "@astrojs/tailwind": "6.0.2",
    "@effect-atom/atom": "^0.5.3",
    "@effect/experimental": "^0.58.0",
    "@effect/platform": "^0.94.5",
    "@effect/platform-browser": "^0.74.0",
    "@effect/platform-bun": "^0.87.1",
    "@effect/sql": "^0.49.0",
    "@effect/sql-kysely": "^0.45.0",
    "@effect/sql-pg": "^0.50.3",
    "astro": "5.16.11",
    "effect": "^3.19.19",
    "fibrae": "0.3.0",
    "graphile-worker": "^0.16.6",
    "graphile-migrate": "2.0.0-rc.2",
    "html-to-text": "^9.0.5",
    "ioredis": "^5.10.0",
    "jose": "^6.2.1",
    "lodash": "^4.17.21",
    "kysely": "^0.28.11",
    "mjml": "^5.0.0-alpha.4",
    "nodemailer": "^6.10.0",
    "@aws-sdk/client-sesv2": "^3.700.0",
    "pg": "^8.20.0",
    "resend": "^6.9.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@effect/language-service": "^0.80.0",
    "@effect/vitest": "^0.27.0",
    "@playwright/test": "^1.58.2",
    "@testcontainers/postgresql": "^11.12.0",
    "@types/bun": "^1.3.10",
    "@types/lodash": "^4.17.0",
    "@types/nodemailer": "^6.4.0",
    "@types/pg": "^8.18.0",
    "@typescript/native-preview": "^7.0.0-dev.20260313.1",
    "autoprefixer": "^10.4.27",
    "effect-devtui": "^0.4.6",
    "kysely-codegen": "^0.20.0",
    "mprocs": "^0.8.3",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "testcontainers": "^11.12.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  }
}
