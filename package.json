{
  "name": "dfg-rocks",
  "type": "module",
  "version": "0.2.0",
  "fromEmail": "noreply@dfg.rocks",
  "projectName": "DFG Music Lessons",
  "scripts": {
    "predev": "bun scripts/dbEnsure.ts",
    "dev": "mprocs",
    "dev:app": "vite dev",
    "typecheck": "tsgo --noEmit -p tsconfig.app.json",
    "typecheck:watch": "tsgo --noEmit --watch -p tsconfig.app.json",
    "build": "vite build",
    "preview": "vite preview",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:ensure": "bun scripts/dbEnsure.ts",
    "db:init": "bun scripts/dbSetup.ts",
    "db:latest": "bun -b graphile-migrate watch --once",
    "db:watch": "bun -b graphile-migrate watch",
    "db:reset": "bun -b graphile-migrate reset --erase",
    "db:types": "bun -b kysely-codegen",
    "db:setup": "run-s db:up db:init db:reset worker:schema db:latest",
    "env:init": "bun scripts/generateEnvFile.ts",
    "init": "NOCONFIRM=1 run-s env:init db:setup",
    "worker": "cd worker && bun --env-file=../.env graphile-worker",
    "worker:schema": "cd worker && bun --env-file=../.env graphile-worker --schema-only",
    "test": "run-p test:unit test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.700.0",
    "@elysiajs/eden": "^1.4.8",
    "@tanstack/react-form": "^1.28.5",
    "@tanstack/react-query": "^5.95.2",
    "@tanstack/react-router": "^1.168.3",
    "@tanstack/react-start": "^1.167.6",
    "@tanstack/valibot-form-adapter": "^0.42.1",
    "elysia": "^1.4.28",
    "graphile-migrate": "2.0.0-rc.2",
    "graphile-worker": "^0.16.6",
    "html-to-text": "^9.0.5",
    "ioredis": "^5.10.0",
    "jose": "^6.2.1",
    "kysely": "^0.28.11",
    "lodash": "^4.17.21",
    "mjml": "^5.0.0-alpha.4",
    "nodemailer": "^6.10.0",
    "pg": "^8.20.0",
    "react": "^19.2.4",
    "react-aria": "^3.47.0",
    "react-aria-components": "^1.16.0",
    "react-dom": "^19.2.4",
    "resend": "^6.9.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "valibot": "^1.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testcontainers/postgresql": "^11.12.0",
    "@types/bun": "^1.3.10",
    "@types/lodash": "^4.17.0",
    "@types/nodemailer": "^6.4.0",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260313.1",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "kysely-codegen": "^0.20.0",
    "mprocs": "^0.8.3",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "testcontainers": "^11.12.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  }
}
