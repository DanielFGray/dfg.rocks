#!/bin/bash
# What "checked" means for dfg.rocks: `ops signoff` and foreman run this on an exported tree,
# which has no .git, no .env and no database. So it runs the checks that need none of them.
# The tests need a database (server/test reads DATABASE_URL), so they run in `bun run test`.
# The type check reads generated/db.ts, which the migrate config writes again after each
# change to migrations/current.
set -euo pipefail

bun run typecheck
bun run lint
