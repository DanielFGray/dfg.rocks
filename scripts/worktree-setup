#!/bin/bash
# A fresh worktree, or the tree `ops signoff` exports, has no installed dependencies.
# bun install is safe to run again, so a re-run also repairs stale dependencies.
set -euo pipefail

bun install --frozen-lockfile

# The unit and e2e tests read the app's config and the shared test database.
# Both scripts preserve existing values, so a re-run only fills what is missing.
bun run db:up
bun run env:init
