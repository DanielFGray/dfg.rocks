---
import { site, contact } from "../config";
---

<section id="contact" class="max-w-[1100px] mx-auto px-5 md:px-8 py-16 md:py-24">
  <div class="max-w-2xl mx-auto text-center">
    <div class="uppercase tracking-[0.15em] text-[0.8rem] text-accent mb-3 font-semibold">{contact.sectionLabel}</div>
    <h2 class="text-4xl font-bold tracking-tight mb-5 leading-[1.15]">{contact.heading}</h2>
    <p class="text-muted mb-10">{contact.description}</p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center mb-10">
      <a
        href={`tel:${site.phone}`}
        class="inline-flex items-center justify-center gap-3 bg-accent text-white px-9 py-4 rounded-xl no-underline font-semibold text-base transition-all hover:bg-accent-hover hover:-translate-y-px"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        Call Me
      </a>
      <a
        href={`mailto:${site.email}`}
        class="inline-flex items-center justify-center gap-3 bg-transparent text-primary px-9 py-4 rounded-xl no-underline font-semibold text-base transition-all border border-white/20 hover:border-accent hover:text-accent hover:-translate-y-px"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        Email Me
      </a>
    </div>

    <div class="flex flex-wrap justify-center gap-x-8 gap-y-3 text-muted text-sm">
      <span><strong class="text-primary">Location:</strong> {site.city}, {site.state}</span>
      <span><strong class="text-primary">Hours:</strong> {site.hours}</span>
    </div>
  </div>
</section>
