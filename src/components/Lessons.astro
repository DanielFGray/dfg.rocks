---
import { lessons } from "../config";
---

<section id="lessons" class="max-w-[1100px] mx-auto px-5 md:px-8 py-16 md:py-24">
  <div class="uppercase tracking-[0.15em] text-[0.8rem] text-accent mb-3 font-semibold">{lessons.sectionLabel}</div>
  <h2 class="text-4xl font-bold tracking-tight mb-5 leading-[1.15]">{lessons.heading}</h2>
  <div class="grid grid-cols-[repeat(auto-fit,minmax(280px,1fr))] gap-6 mt-10">
    {lessons.items.map((lesson) => (
      <div class="bg-card rounded-xl p-8 border border-white/[0.06] transition-all duration-200 hover:border-accent/30 hover:-translate-y-0.5">
        <div class="text-[2rem] mb-4">{lesson.icon}</div>
        <h3 class="text-xl font-semibold mb-2">{lesson.title}</h3>
        <p class="text-muted text-[0.95rem]">{lesson.description}</p>
        <div class="flex gap-2 mt-4">
          {lesson.formats.map((f) => (
            <span class="text-xs px-3 py-1 rounded-full bg-accent/[0.12] text-accent font-semibold">{f}</span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
