---
import { hero } from "../config";
---

<section class="max-w-[1100px] mx-auto px-5 md:px-8 pb-16 md:pb-24 pt-20 min-h-[85vh] md:min-h-screen flex flex-col justify-center">
  <div class="uppercase tracking-[0.15em] text-[0.85rem] text-accent mb-4 font-semibold">{hero.eyebrow}</div>
  <h1 class="text-[clamp(2.5rem,6vw,4.5rem)] font-bold leading-[1.1] tracking-tight mb-6">{hero.headline}</h1>
  <p class="text-[1.2rem] text-muted max-w-[540px] mb-10">{hero.subtitle}</p>
  <div class="flex flex-col items-start gap-3 md:flex-row md:items-center md:gap-4">
    {hero.cta.map((c) => (
      <a href={c.href} class:list={[
        "inline-block rounded-xl no-underline font-semibold text-base transition-all cursor-pointer px-9 py-4",
        c.outline
          ? "bg-transparent border-2 border-white/15 hover:border-white/40 hover:bg-white/5"
          : "bg-accent text-white hover:bg-accent-hover hover:-translate-y-px"
      ]}>{c.label}</a>
    ))}
  </div>
</section>
