---
import { testimonials } from "../config";
---

<section id="testimonials" class="max-w-[1100px] mx-auto px-5 md:px-8 py-16 md:py-24">
  <div class="uppercase tracking-[0.15em] text-[0.8rem] text-accent mb-3 font-semibold">{testimonials.sectionLabel}</div>
  <h2 class="text-4xl font-bold tracking-tight mb-5 leading-[1.15]">{testimonials.heading}</h2>
  <div class="grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-6 mt-10">
    {testimonials.items.map((t) => (
      <div class="bg-card rounded-xl p-8 border border-white/[0.06]">
        <blockquote class="italic text-muted mb-4 leading-[1.7]">&ldquo;{t.quote}&rdquo;</blockquote>
        <div class="text-[0.9rem] font-semibold">
          {t.name} <span class="text-muted font-normal">&mdash; {t.role}</span>
        </div>
      </div>
    ))}
  </div>
</section>
