---
import { site } from "../config";
import Nav from "./Nav.astro";
import Footer from "./Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.business} | Drums, Guitar & More in ${site.city}`,
  description = `Private music lessons with ${site.name}. Drums, guitar, piano and more. In-person and online lessons in ${site.city}.`,
} = Astro.props;
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,600;0,9..40,700;1,9..40,400&display=swap"
      rel="stylesheet"
    />

    <!-- Structured data for Google -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        name: site.business,
        description: `Private music lessons — drums, guitar, piano and more. In-person and online.`,
        url: Astro.url.origin,
        telephone: site.phone,
        address: {
          "@type": "PostalAddress",
          addressLocality: site.city,
          addressRegion: site.state,
        },
        priceRange: "$$",
        openingHours: "Mo-Sa 09:00-20:00",
        sameAs: [],
      })}
    />
  </head>
  <body class="bg-surface text-primary font-sans text-lg leading-relaxed">
    <Nav />
    <slot />
    <Footer />
  </body>
</html>
