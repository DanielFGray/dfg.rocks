---
import { site, about } from "../config";
---

<section id="about">
  <div class="about-grid">
    <div class="about-photo"><img src={site.gravatar} alt={site.name} /></div>
    <div class="about-text">
      <div class="section-label">{about.sectionLabel}</div>
      <h2>{about.heading}</h2>
      {about.paragraphs.map(p => <p>{p}</p>)}
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .about-photo {
    width: 100%;
    max-height: 50vh;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .about-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .about-text p {
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  @media (max-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
